{
  "name": "@fairu/player",
  "version": "1.6.0",
  "type": "module",
  "description": "A lightweight, modular React podcast player with TypeScript",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/player.css",
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "require": "./dist/embed.cjs"
    },
    "./wc": {
      "types": "./dist/wc/index.d.ts",
      "import": "./dist/wc.js",
      "require": "./dist/wc.cjs"
    },
    "./cdn": "./dist/fairu-player.iife.js",
    "./cdn-light": "./dist/fairu-player.light.iife.js",
    "./cdn-loader": "./dist/fairu-player.loader.iife.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --mode lib",
    "build:cdn": "npm run build:lib && npm run build:cdn-standalone && npm run build:cdn-light && npm run build:cdn-loader",
    "build:cdn-standalone": "vite build --mode cdn-standalone",
    "build:cdn-light": "vite build --mode cdn-light",
    "build:cdn-loader": "vite build --mode cdn-loader",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 94",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.7.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@angular/compiler": "^21.2.20",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^13.0.3",
    "@storybook/addon-links": "^10.5.5",
    "@storybook/react": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "size-limit": "^13.0.3",
    "storybook": "^10.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.0.17",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "react",
    "podcast",
    "player",
    "audio",
    "typescript",
    "tailwind"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/sushidev-team/fairu-player.git"
  },
  "size-limit": [
    {
      "name": "React entry (react external)",
      "path": "dist/index.js",
      "limit": "33 kB"
    },
    {
      "name": "Audio player chunk",
      "path": "dist/Player-*.js",
      "limit": "29 kB"
    },
    {
      "name": "Video player chunk (hls.js excluded)",
      "path": "dist/VideoPlayer-*.js",
      "limit": "32 kB"
    },
    {
      "name": "hls.js, fetched only for HLS sources",
      "path": "dist/hls-*.js",
      "limit": "200 kB"
    },
    {
      "name": "Stylesheet",
      "path": "dist/player.css",
      "limit": "10 kB"
    },
    {
      "name": "Custom element entry",
      "path": "dist/wc.js",
      "limit": "3 kB"
    }
  ]
}
