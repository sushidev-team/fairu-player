{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@fairu/player/wc": ["../dist/wc"]
    }
  },
  "include": ["apps", "shared", "tests", "*.ts"]
}
